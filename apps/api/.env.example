# API runtime
PORT=4000
NODE_ENV=development

# Required PostgreSQL connection URL. Credentials may be supplied in a local
# .env file when required by the selected development database.
DATABASE_URL=postgresql://localhost:5432/iamonit

# Required server-only values. Replace these placeholders locally; never expose
# them through NEXT_PUBLIC_ variables or commit real values.
JWT_SECRET=replace-with-a-local-development-secret
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=replace-with-a-local-development-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-a-local-development-service-role-key
