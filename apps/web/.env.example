# Browser-exposed values must use the NEXT_PUBLIC_ prefix. Never place the
# service-role key, JWT signing secret, database URL, or other server secrets here.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-a-local-development-anon-key
